{
  "Version": "2019-10-30",
  "StartAction": "a1-recording",
  "Metadata": {
    "name": "Utility Main IVR",
    "description": "Synthetic sample for Get-ConnectInventory.ps1 self-test. All numbers and Ids are fake.",
    "type": "contactFlow",
    "ActionMetadata": {
      "a9-agent": { "ContactFlow": { "id": "arn:aws:connect:us-east-1:111122223333:instance/00000000-0000-0000-0000-000000000000/contact-flow/00000000-0000-0000-0000-000000000002", "text": "Utility Agent Transfer" } }
    }
  },
  "Actions": [
    {
      "Identifier": "a1-recording",
      "Type": "UpdateContactRecordingBehavior",
      "Parameters": { "RecordingBehavior": { "RecordedParticipants": ["Agent", "Customer"] } },
      "Transitions": { "NextAction": "a2-voice" }
    },
    {
      "Identifier": "a2-voice",
      "Type": "UpdateContactTextToSpeechVoice",
      "Parameters": { "TextToSpeechVoice": "SampleVoice" },
      "Transitions": { "NextAction": "a3-welcome" }
    },
    {
      "Identifier": "a3-welcome",
      "Type": "MessageParticipant",
      "Parameters": { "Text": "Thank you for calling City Water and Power. For emergencies call 202-555-0199." },
      "Transitions": { "NextAction": "a4-menu" }
    },
    {
      "Identifier": "a4-menu",
      "Type": "GetParticipantInput",
      "Parameters": {
        "SSML": "<speak><prosody rate=\"95%\">For billing press 1. To report an outage press 2. To speak with an agent press 9.</prosody></speak>",
        "InputTimeLimitSeconds": "8",
        "StoreInput": "False"
      },
      "Transitions": {
        "NextAction": "a4-menu",
        "Conditions": [
          { "NextAction": "a5-account", "Condition": { "Operator": "Equals", "Operands": ["1"] } },
          { "NextAction": "a8-emergency", "Condition": { "Operator": "Equals", "Operands": ["2"] } },
          { "NextAction": "a9-agent", "Condition": { "Operator": "Equals", "Operands": ["9"] } }
        ],
        "Errors": [
          { "NextAction": "a4-menu", "ErrorType": "InputTimeLimitExceeded" },
          { "NextAction": "a4-menu", "ErrorType": "NoMatchingCondition" },
          { "NextAction": "a10-bye", "ErrorType": "NoMatchingError" }
        ]
      }
    },
    {
      "Identifier": "a5-account",
      "Type": "GetParticipantInput",
      "Parameters": {
        "Text": "Please enter your 10 digit account number.",
        "StoreInput": "True",
        "InputTimeLimitSeconds": "10",
        "InputValidation": { "CustomValidation": { "MaximumLength": "10" } }
      },
      "Transitions": { "NextAction": "a6-lambda", "Errors": [ { "NextAction": "a9-agent", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "a6-lambda",
      "Type": "InvokeLambdaFunction",
      "Parameters": {
        "LambdaFunctionARN": "arn:aws:lambda:us-east-1:111122223333:function:billing-amount-due",
        "InvocationTimeLimitSeconds": "8",
        "LambdaInvocationAttributes": { "accountNumber": "$.StoredCustomerInput", "apiKey": "abcd1234efgh5678ijkl9012mnop3456qrst" }
      },
      "Transitions": { "NextAction": "a7-attrs", "Errors": [ { "NextAction": "a9-agent", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "a7-attrs",
      "Type": "UpdateContactAttributes",
      "Parameters": { "Attributes": { "menuChoice": "billing", "amountDue": "$.External.amountDue" } },
      "Transitions": { "NextAction": "a10-bye" }
    },
    {
      "Identifier": "a8-emergency",
      "Type": "TransferParticipantToThirdParty",
      "Parameters": { "ThirdPartyPhoneNumber": "+12025550199", "ThirdPartyConnectionTimeLimitSeconds": "30" },
      "Transitions": { "NextAction": "a10-bye", "Errors": [ { "NextAction": "a9-agent", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "a9-agent",
      "Type": "TransferToFlow",
      "Parameters": { "ContactFlowId": "arn:aws:connect:us-east-1:111122223333:instance/00000000-0000-0000-0000-000000000000/contact-flow/00000000-0000-0000-0000-000000000002" },
      "Transitions": { "Errors": [ { "NextAction": "a10-bye", "ErrorType": "NoMatchingError" } ] }
    },
    {
      "Identifier": "a10-bye",
      "Type": "DisconnectParticipant",
      "Parameters": {},
      "Transitions": {}
    }
  ]
}

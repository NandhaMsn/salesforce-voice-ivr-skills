<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic multi-client self-test: calls its own subflow (ok) and another client's subflow (client-isolation ERROR). -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <interviewLabel>IVR ACME Entry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IVR ACME Entry</label>
    <processType>RoutingFlow</processType>
    <recordUpdates>
        <name>Tag_Client</name>
        <label>Tag Client</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Own_Feature</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Own_Feature</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>recordId</elementReference></value>
        </filters>
        <inputAssignments>
            <field>IVR_Client__c</field>
            <value><stringValue>ACME</stringValue></value>
        </inputAssignments>
        <object>VoiceCall</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Tag_Client</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <subflows>
        <name>Own_Feature</name>
        <label>Own Feature</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Other_Client_Feature</targetReference>
        </connector>
        <flowName>IVR_ACME_Agent_Handoff</flowName>
    </subflows>
    <subflows>
        <name>Other_Client_Feature</name>
        <label>Other Client Feature</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>IVR_GLOBEX_Agent_Handoff</flowName>
    </subflows>
</Flow>

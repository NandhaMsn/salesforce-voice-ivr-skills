<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic multi-client self-test: VoiceCall trigger scoped to the client's outbound caller ID (no findings expected). -->
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Close_Open_Requests</name>
        <label>Close Open Requests</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CallbackRequestService</actionName>
        <actionType>apex</actionType>
        <faultConnector>
            <targetReference>Keep_Error</targetReference>
        </faultConnector>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>Keep_Error</name>
        <label>Keep Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>$Flow.FaultMessage</elementReference></value>
        </assignmentItems>
    </assignments>
    <interviewLabel>IVR ACME Callback Close {!$Flow.CurrentDateTime}</interviewLabel>
    <label>IVR ACME Callback Close</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Close_Open_Requests</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>CallType</field>
            <operator>EqualTo</operator>
            <value><stringValue>Outbound</stringValue></value>
        </filters>
        <filters>
            <field>FromPhoneNumber</field>
            <operator>EqualTo</operator>
            <value><stringValue>+12025550100</stringValue></value>
        </filters>
        <object>VoiceCall</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
